    { "key": "weapon.jam_jar.desc", "value": "Wirft ein Glas in deine Nähe. Dort bleibt eine Marmeladenlache liegen, die Gegner darin verletzt." },
    { "key": "weapon.coffee_pool.name", "value": "Kaffeepfütze" },
    { "key": "weapon.coffee_pool.desc", "value": "Eine Kaffeepfütze breitet sich unter dir aus und wandert mit dir mit. Wer darin steht, nimmt Schaden." },
    { "key": "weapon.boba_gun.name", "value": "Boba-Kanone" },
    { "key": "weapon.boba_gun.desc", "value": "Schießt Bobaperlen schräg in alle vier Ecken. Sie durchschlagen jeden Gegner auf ihrem Weg." },
    { "key": "weapon.spike_fork.name", "value": "Stachelgabel" },
    { "key": "weapon.spike_fork.desc", "value": "Sticht blitzschnell links und rechts neben dir zu. Ideal gegen alles, was dir auf die Pelle rückt." },
    { "key": "weapon.deathstrike.name", "value": "Todesstoß" },
    { "key": "weapon.deathstrike.desc", "value": "Lässt Todesstöße direkt auf zufällige Gegner in deiner Nähe niedergehen, ganz ohne zu zielen." },
    { "key": "weapon.void_spike.name", "value": "Leerenstachel" },
    { "key": "weapon.void_spike.desc", "value": "Lässt an zufälligen Stellen um dich Stacheln aus dem Boden schießen, auch wo gar kein Gegner steht." },
    { "key": "weapon.celestial_star.name", "value": "Himmelsstern" },
    { "key": "weapon.celestial_star.desc", "value": "Ein Stern prallt quer über den Bildschirm von Rand zu Rand und trifft alles, was ihm begegnet." },
    { "key": "weapon.fire_ball.name", "value": "Feuerball" },
    { "key": "weapon.fire_ball.desc", "value": "Schleudert Feuerbälle auf den nächsten Gegner. Beim Aufprall explodieren sie mit Flächenschaden." },
    { "key": "weapon.blade_swarm.name", "value": "Klingenschwarm" },
    { "key": "weapon.blade_swarm.desc", "value": "Sammelt Klingen um dich, die dann gebündelt auf einen Gegner zuschießen und ihn verfolgen." },
    { "key": "weapon.candy_bomb.name", "value": "Bonbonbombe" },
    { "key": "weapon.candy_bomb.desc", "value": "Legt Bonbonbomben zu deinen Füßen ab. Kurz darauf explodieren sie mit großem Radius." },
    { "key": "weapon.boomerang.name", "value": "Bumerang" },
    { "key": "weapon.boomerang.desc", "value": "Wirft einen Bumerang am nächsten Gegner vorbei. Er kehrt zurück und trifft auf Hin- und Rückweg." },
    { "key": "weapon.time_laser.name", "value": "Zeitlaser" },
    { "key": "weapon.time_laser.desc", "value": "Feuert Zeitstrahlen auf zufällige Gegner in der Nähe und bremst sie fast bis zum Stillstand." },
    { "key": "weapon.crumb_trail.name", "value": "Krümelspur" },
    { "key": "weapon.crumb_trail.desc", "value": "Du hinterlässt beim Laufen eine Spur aus Krümeln. Gegner, die hineinlaufen, nehmen Schaden." },
    { "key": "weapon.vortex.name", "value": "Strudel" },
    { "key": "weapon.vortex.desc", "value": "Öffnet beim nächsten Gegner einen Strudel, der Feinde in seine Mitte zieht, sie verlangsamt und dort zermahlt." },
    { "key": "weapon.turret.name", "value": "Geschütz" },
    { "key": "weapon.turret.desc", "value": "Baut kleine Geschütztürme neben dir auf. Sie bleiben stehen und beschießen selbstständig Gegner." },
    { "key": "weapon.sword_slash.name", "value": "Schwerthieb" },
    { "key": "weapon.sword_slash.desc", "value": "Schlägt in Laufrichtung einen breiten Bogen vor dir. Höhere Stufen schlagen schneller und mehrmals hin und her." },
    { "key": "weapon.salad_fan.name", "value": "Salatfächer" },
    { "key": "weapon.salad_fan.desc", "value": "Fächert sichelförmige Druckwellen auf nahe Gegner. Jede Welle durchschlägt mehrere Gegner, stößt sie zurück, verlangsamt sie und wird dabei schwächer. Höhere Stufen schießen mehr Wellen, die weiter durchschlagen und weniger Kraft verlieren." },
    { "key": "weapon.buff_damage.name", "value": "Schaden" },
    { "key": "weapon.buff_damage.desc", "value": "Alle deine Waffen richten mehr Schaden an." },
    { "key": "weapon.buff_crit_chance.name", "value": "Krit-Chance" },
    { "key": "weapon.buff_crit_chance.desc", "value": "Erhöht die Chance, dass deine Treffer kritisch sind." },
    { "key": "weapon.buff_crit_damage.name", "value": "Krit-Schaden" },
    { "key": "weapon.buff_crit_damage.desc", "value": "Kritische Treffer richten noch mehr Schaden an." },
    { "key": "weapon.buff_cooldown.name", "value": "Abklingzeit" },
    { "key": "weapon.buff_cooldown.desc", "value": "Deine Waffen laden schneller nach und greifen öfter an." },
    { "key": "weapon.buff_duration.name", "value": "Wirkdauer" },
    { "key": "weapon.buff_duration.desc", "value": "Alles, was deine Waffen beschwören oder hinterlassen, bleibt länger bestehen." },
    { "key": "weapon.buff_aoe_range.name", "value": "Wirkbereich" },
    { "key": "weapon.buff_aoe_range.desc", "value": "Vergrößert Flächen, Explosionen und Geschosse deiner Waffen." },
    { "key": "weapon.buff_extra_shot.name", "value": "Extraschuss" },
    { "key": "weapon.buff_extra_shot.desc", "value": "Deine Waffen feuern bei jedem Angriff zusätzliche Geschosse ab." },
    { "key": "weapon.buff_max_hp.name", "value": "Max. Leben" },
    { "key": "weapon.buff_max_hp.desc", "value": "Erhöht dein maximales Leben und heilt dich bei jeder Stufe ein Stück." },
    { "key": "weapon.buff_regeneration.name", "value": "Regeneration" },
    { "key": "weapon.buff_regeneration.desc", "value": "Heilt dich in regelmäßigen Abständen, solange du verletzt bist." },
    { "key": "weapon.buff_armor.name", "value": "Rüstung" },
    { "key": "weapon.buff_armor.desc", "value": "Verringert den Schaden, den du von Gegnern einsteckst." },
    { "key": "weapon.buff_dodge.name", "value": "Ausweichen" },
    { "key": "weapon.buff_dodge.desc", "value": "Gibt dir eine Chance, einem Treffer komplett auszuweichen." },
    { "key": "weapon.buff_second_chance.name", "value": "Zweite Chance" },
    { "key": "weapon.buff_second_chance.desc", "value": "Rettet dich vor dem Tod: Du stehst mit etwas Leben wieder auf und bist kurz unverwundbar." },
    { "key": "weapon.buff_life_steal.name", "value": "Lebensraub" },
    { "key": "weapon.buff_life_steal.desc", "value": "Deine Treffer haben eine Chance, dir Leben zurückzugeben." },
    { "key": "weapon.buff_glass_cannon.name", "value": "Glaskanone" },
    { "key": "weapon.buff_glass_cannon.desc", "value": "Deutlich mehr Schaden für alle Waffen, aber dein maximales Leben sinkt." },
    { "key": "weapon.buff_move_speed.name", "value": "Tempo" },
    { "key": "weapon.buff_move_speed.desc", "value": "Du läufst schneller." },
    { "key": "weapon.buff_pickup_range.name", "value": "Sammelweite" },
    { "key": "weapon.buff_pickup_range.desc", "value": "Du sammelst Erfahrung und Beute schon aus größerer Entfernung ein." },
    { "key": "weapon.buff_xp_gain.name", "value": "Erfahrung" },
    { "key": "weapon.buff_xp_gain.desc", "value": "Du bekommst mehr Erfahrung und steigst schneller auf." },
    { "key": "weapon.buff_currency.name", "value": "Münzen" },
    { "key": "weapon.buff_currency.desc", "value": "Du bekommst mehr Münzen." },
    { "key": "weapon.buff_luck.name", "value": "Glück" },
    { "key": "weapon.buff_luck.desc", "value": "Beim Aufstieg erscheinen öfter seltene Verbesserungen." },
    { "key": "weapon.evo_boba_saw.name", "value": "Boba-Säge" },
    { "key": "weapon.evo_boba_saw.desc", "value": "Versprüht eine Zeit lang Bobaperlen in einer rotierenden Spirale rund um dich." },
    { "key": "weapon.evo_shuril_blast.name", "value": "Shuri-Blast" },
    { "key": "weapon.evo_shuril_blast.desc", "value": "Feuert Salven von Wurfsternen auf den nächsten Gegner, die ganze Reihen von Feinden durchbohren." },
    { "key": "weapon.evo_explosive_star.name", "value": "Explosivstern" },
    { "key": "weapon.evo_explosive_star.desc", "value": "Ein Stern prallt über den Bildschirm und explodiert an jedem Gegner, den er berührt." },
    { "key": "weapon.evo_bloody_fork.name", "value": "Blutgabel" },
    { "key": "weapon.evo_bloody_fork.desc", "value": "Sticht gleichzeitig in alle acht Richtungen um dich herum zu." },
    { "key": "weapon.evo_blade_storm.name", "value": "Klingensturm" },
    { "key": "weapon.evo_blade_storm.desc", "value": "Klingen kreisen um dich und schneiden alles, was sie berühren. Dann schnellen sie auf Gegner los und wirbeln zurück." },
    { "key": "weapon.evo_boomerang.name", "value": "Sturmbumerang" },
    { "key": "weapon.evo_boomerang.desc", "value": "Wirft einen ganzen Ring aus wirbelnden Bumerangs in alle Richtungen." },
    { "key": "weapon.evo_bomb_swarm.name", "value": "Bombensäge" },
    { "key": "weapon.evo_bomb_swarm.desc", "value": "Sägen kreisen um dich und explodieren an jedem Gegner, den sie berühren." },
    { "key": "weapon.evo_sticky_shatter.name", "value": "Klebesplitter" },
    { "key": "weapon.evo_sticky_shatter.desc", "value": "Ein Glas zerspringt in mehrere klebrige Lachen, die Gegner verletzen und stark verlangsamen." },
