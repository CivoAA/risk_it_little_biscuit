    { "key": "weapon.buff_armor.name", "value": "Armor" },
    { "key": "weapon.buff_armor.desc", "value": "Reduces the damage you take from enemies." },
    { "key": "weapon.buff_dodge.name", "value": "Dodge Chance" },
