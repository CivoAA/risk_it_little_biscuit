    { "key": "weapon.boomerang.desc", "value": "Throws a boomerang past the nearest enemy. It swings back and hits on the way out and in." },
    { "key": "weapon.time_laser.name", "value": "Time Laser" },
    { "key": "weapon.time_laser.desc", "value": "Fires time beams at random nearby enemies, slowing them almost to a standstill." },
    { "key": "weapon.crumb_trail.name", "value": "Crumb Trail" },
    { "key": "weapon.crumb_trail.desc", "value": "You leave a trail of crumbs as you walk. Enemies that step into it take damage." },
    { "key": "weapon.vortex.name", "value": "Vortex" },
    { "key": "weapon.vortex.desc", "value": "Opens a vortex at the nearest enemy that drags foes into its center and grinds them down." },
    { "key": "weapon.turret.name", "value": "Turret" },
    { "key": "weapon.turret.desc", "value": "Builds small turrets next to you. They stay put and shoot at enemies on their own." },
