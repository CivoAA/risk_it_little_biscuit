    { "key": "weapon.coffee_pool.name", "value": "Coffee Pool" },
    { "key": "weapon.coffee_pool.desc", "value": "A coffee puddle spreads out beneath you and moves along with you, hurting everything inside it." },
    { "key": "weapon.boba_gun.name", "value": "Boba Gun" },
    { "key": "weapon.boba_gun.desc", "value": "Shoots boba pearls diagonally toward all four corners. They pierce every enemy along the way." },
    { "key": "weapon.spike_fork.name", "value": "Spike Fork" },
