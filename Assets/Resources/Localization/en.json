    { "key": "weapon.celestial_star.name", "value": "Celestial Star" },
    { "key": "weapon.celestial_star.desc", "value": "A star ricochets across the screen from edge to edge, hitting everything it passes." },
    { "key": "weapon.fire_ball.name", "value": "Fire Ball" },
    { "key": "weapon.fire_ball.desc", "value": "Hurls fireballs at the nearest enemy. On impact they explode and hit everything around it." },
    { "key": "weapon.blade_swarm.name", "value": "Blade Swarm" },
    { "key": "weapon.blade_swarm.desc", "value": "Gathers blades around you, then fires them all at one enemy and chases it down." },
    { "key": "weapon.candy_bomb.name", "value": "Candy Bomb" },
    { "key": "weapon.candy_bomb.desc", "value": "Drops candy bombs at your feet. Moments later they explode in a wide radius." },
