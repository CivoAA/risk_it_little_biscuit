    { "key": "weapon.buff_life_steal.name", "value": "Life Steal" },
    { "key": "weapon.buff_life_steal.desc", "value": "Your hits have a chance to give you health back." },
    { "key": "weapon.buff_glass_cannon.name", "value": "Glass Cannon" },
    { "key": "weapon.buff_glass_cannon.desc", "value": "Much more damage for all weapons, but your maximum health drops." },
    { "key": "weapon.buff_move_speed.name", "value": "Move Speed" },
    { "key": "weapon.buff_move_speed.desc", "value": "You move faster." },
    { "key": "weapon.buff_pickup_range.name", "value": "Pickup Range" },
    { "key": "weapon.buff_pickup_range.desc", "value": "You collect experience and loot from further away." },
