    { "key": "weapon.butterblast.name", "value": "Butterblast" },
    { "key": "weapon.butterblast.desc", "value": "Fires butter blobs at the nearest enemy. They fly straight through everything in their path." },
    { "key": "weapon.jam_jar.name", "value": "Throwing Jam Jar" },
